  m_text: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0438\u0436\u0435, \n\u0438
    \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435, \u043A\u0430\u043A
    \u0441\u043E\u0447\u0435\u0442\u0430\u044E\u0442\u0441\u044F \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438 \u0438 \u0438\u0441\u0442\u043E\u0440\u0438\u044F
    \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F \u0440\u043E\u0434\u043D\u043E\u0433\u043E
    \u0433\u043E\u0440\u043E\u0434\u0430 - \u041F\u0435\u0440\u0432\u043E\u0443\u0440\u0430\u043B\u044C\u0441\u043A\u0430."
